# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# generated review bundle (regenerate from docs/MENTOR_REVIEW_PACKAGE.md file list)
/docs/mentor-review-package.zip

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client (regenerated via `npm run db:generate`)
/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Gate 4 review bundle
/docs/gate4-implementation-package.zip

# Deployment hygiene
node_modules/
.next/
.env
.env.*
playwright-report/
test-results/
tsconfig.tsbuildinfo
