// Prisma schema — HMIS Cameroon (SIGH/DME prototype)
// Build Step 3: the first walking-skeleton data model (05_Logical_Data_Model_v0 §4).
// Gate 2 (Phase 1): additive data-model foundation per the approved Gate 1 proposal
// (Planning 19/20) and preflight (21) — Department/ServiceUnit/Setting/DocumentTemplate,
// PatientContact/PatientIdentifier/PatientDuplicateCandidate, Observation/Diagnosis,
// Tariff/PriceList (+ optional InvoiceItem→Tariff source). Dev/test + fake data only.
//
// Rules embodied here:
//  - Hospital-scoped operational records carry `hospitalId` (D-011, 05 §7).
//  - Money is INTEGER FCFA — no floats anywhere (D-009, 05 §9).
//  - Status stored as neutral codes (enums); French labels live in the UI (05 §5).
//  - Soft-delete (`deletedAt`) on operational records; AuditLog is append-only.
//  - Per-hospital human-readable numbers come from the Sequence counter (05 §6).
//  - Fake data only — no real patient data (A-001/D-008).
//  - Existing Phase 0 models/fields are PRESERVED (additive only); free-text
//    Consultation.vitals/.provisionalDiagnosis are kept during the transition;
//    InvoiceItem keeps its historical snapshot.
//
// Still NOT modelled (blocked from this batch): Prescription/Order, Practitioner, a
// separate Receipt entity, partial-payment workflow, national MPI / merge, and all
// Phase 2 (lab, pharmacy, hospitalization, …) / Phase 4 modules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== Enums (neutral codes; FR labels in UI) =====================

enum Sex {
  male
  female
}

enum UserStatus {
  active
  disabled
}

enum EncounterStatus {
  open
  closed
  cancelled
}

enum ConsultationStatus {
  draft
  finalized
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  cancelled
}

enum PaymentStatus {
  recorded
  cancelled
}

enum PaymentMethod {
  cash
  mobile_money
  card
  bank_transfer
}

enum SequenceType {
  patient
  encounter
  invoice
  receipt
  // Phase 2C — refund voucher ("avoir") and cashier shift / Brouillard de Caisse numbers.
  refund_voucher
  cashier_shift
  // Phase 2D-2 — prescription ("ordonnance") number.
  prescription
  // Phase 2D-5 — dispense record number.
  dispense
  // Phase 2G — hospitalization admission number.
  admission
  // Phase 2I — lab / radiology diagnostic order number (examen).
  diagnostic
}

/// Phase 2D-2 — structured prescription lifecycle. Dispensing transitions (partially_dispensed /
/// dispensed) are driven later by 2D-5; 2D-2 itself produces draft → finalized → sent_to_pharmacy.
enum PrescriptionStatus {
  draft
  finalized
  sent_to_pharmacy
  partially_dispensed
  dispensed
  cancelled
}

/// Phase 2D-4 — stock reservation lifecycle: `active` holds `quantityReserved` on a batch; `released`
/// (48h non-collection or prescription cancellation) returns it; `consumed` (dispensing, 2D-5)
/// fulfils it (the on-hand was deducted).
enum ReservationStatus {
  active
  released
  consumed
}

/// Phase 2D-7 — a stock adjustment kind. `increase` corrects a count up; `decrease` corrects it down;
/// `loss` writes off damaged/lost units; `expiry` removes expired stock. All but `increase` reduce
/// on-hand. The magnitude is the (positive) `quantity` on the adjustment.
enum StockAdjustmentType {
  increase
  decrease
  loss
  expiry
}

/// Phase 2D-7 — dual-validation lifecycle: a pharmacist REQUESTS, the Pharmacist-in-Charge decides.
enum StockAdjustmentStatus {
  requested
  approved
  rejected
}

/// Phase 2F — per-service queue ticket lifecycle. `waiting → in_service → completed`, or
/// `waiting → cancelled`. (`in_service` covers in-consultation / in-lab / at-the-counter.)
enum QueueStatus {
  waiting
  in_service
  completed
  cancelled
}

/// Phase 2H — emergency-debt ledger entry lifecycle. `outstanding → settled` (paid later at the
/// cashier) or `outstanding → waived` (formally waived by the Hospital Director with a reason).
enum EmergencyDebtStatus {
  outstanding
  settled
  waived
}

// ===================== Phase 2C — cashier/billing strengthening =====================

/// Invoice cancellation request lifecycle: a cashier requests, a Hospital Administrator decides.
enum CancellationRequestStatus {
  requested
  approved
  rejected
}

/// Refund voucher lifecycle for a cancelled PAID invoice: requested → approved → paid (+ cancelled).
enum RefundVoucherStatus {
  requested
  approved
  paid
  cancelled
}

/// Cashier shift / Brouillard de Caisse lifecycle: opened, then closed (figures frozen), and — only
/// through the controlled correction workflow — corrected. The frozen figures are never mutated.
enum CashierShiftStatus {
  open
  closed
  corrected
}

/// Phase 2A — service/department catalogue classification (neutral codes; Fr/En labels in UI).
enum ServiceType {
  OUTPATIENT
  INPATIENT_WARD
  SUPPORT
  CASHIER
  PHARMACY
  LABORATORY
  IMAGING
  EMERGENCY
  ADMINISTRATION
}

// ===================== Organization =====================

/// One of the regional hospitals; the tenant root. Not itself hospital-scoped.
model Hospital {
  id        String   @id
  code      String   @unique
  name      String
  city      String
  region    String
  isActive  Boolean  @default(false)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles     UserRole[]
  patients      Patient[]
  encounters    Encounter[]
  consultations Consultation[]
  invoices      Invoice[]
  invoiceItems  InvoiceItem[]
  payments      Payment[]
  auditLogs     AuditLog[]
  sequences     Sequence[]

  // Phase 2C additive relations.
  cancellationRequests    InvoiceCancellationRequest[]
  refundVouchers          RefundVoucher[]
  cashierShifts           CashierShift[]
  cashierShiftCorrections CashierShiftCorrection[]

  // Phase 2D additive relations.
  medications              Medication[]
  prescriptions            Prescription[]
  prescriptionItems        PrescriptionItem[]
  medicationStockBatches   MedicationStockBatch[]
  stockReservations        StockReservation[]
  dispenseRecords          DispenseRecord[]
  dispenseRecordItems      DispenseRecordItem[]
  stockAdjustments         StockAdjustment[]
  reportExports            ReportExport[]
  queueTickets             QueueTicket[]
  emergencyDebts           EmergencyDebt[]
  admissions               Admission[]
  admissionDailyCharges    AdmissionDailyCharge[]
  diagnosticCatalogueItems DiagnosticCatalogueItem[]
  diagnosticOrders         DiagnosticOrder[]

  // Phase 1 (Gate 2) additive relations.
  departments                Department[]
  serviceUnits               ServiceUnit[]
  settings                   Setting[]
  documentTemplates          DocumentTemplate[]
  priceLists                 PriceList[]
  tariffs                    Tariff[]
  patientContacts            PatientContact[]
  patientIdentifiers         PatientIdentifier[]
  patientDuplicateCandidates PatientDuplicateCandidate[]
  observations               Observation[]
  diagnoses                  Diagnosis[]

  // Phase 3A (multi-hospital configuration foundation) — guarded template-apply records
  // belonging to this hospital instance (additive; config only, never patient/transaction).
  configurationTemplateApplications ConfigurationTemplateApplication[]

  // Phase 3C (site-readiness checklist) — per-hospital readiness status items (additive).
  siteReadinessItems SiteReadinessItem[]
}

// ===================== Users / RBAC =====================

/// Named role (global definition); assigned to a user within a hospital via UserRole.
model Role {
  id        String   @id
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]
}

/// Authenticated account (Auth.js identity). Identity is global; access is contextual.
model User {
  id           String     @id
  displayName  String
  email        String     @unique
  /// bcrypt hash of the demo password (verification logic arrives at Step 4).
  passwordHash String
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userRoles          UserRole[]
  auditLogs          AuditLog[]     @relation("AuditActor")
  consultations      Consultation[] @relation("ConsultationPerformedBy")
  encountersAssigned Encounter[]    @relation("EncounterAssignedTo")
  payments           Payment[]      @relation("PaymentCashier")

  // Phase 2C additive relations (cancellation / refund / shift actors).
  cancellationRequestsMade    InvoiceCancellationRequest[] @relation("CancellationRequestedBy")
  cancellationRequestsDecided InvoiceCancellationRequest[] @relation("CancellationDecidedBy")
  refundVouchersRequested     RefundVoucher[]              @relation("RefundRequestedBy")
  refundVouchersApproved      RefundVoucher[]              @relation("RefundApprovedBy")
  refundVouchersExecuted      RefundVoucher[]              @relation("RefundExecutedBy")
  refundVouchersCancelled     RefundVoucher[]              @relation("RefundCancelledBy")
  cashierShifts               CashierShift[]               @relation("ShiftCashier")
  cashierShiftsClosed         CashierShift[]               @relation("ShiftClosedBy")
  cashierShiftCorrections     CashierShiftCorrection[]     @relation("ShiftCorrectedBy")

  // Phase 2D-2 additive relation.
  stockAdjustmentsRequested StockAdjustment[] @relation("StockAdjustmentRequestedBy")
  stockAdjustmentsDecided   StockAdjustment[] @relation("StockAdjustmentDecidedBy")
  reportExports             ReportExport[]    @relation("ReportExportedBy")
  prescriptionsPrescribed   Prescription[]    @relation("PrescriptionPrescribedBy")
  // Phase 2D-5 additive relations.
  prescriptionsPaid         Prescription[]    @relation("PrescriptionPaidBy")
  dispensesPerformed        DispenseRecord[]  @relation("DispensePerformedBy")
}

/// Assignment of a Role to a User, scoped to a Hospital (minimal RBAC, 05 §4).
model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  hospitalId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([userId, roleId, hospitalId])
  @@index([hospitalId])
}

// ===================== Patient identity =====================

/// A person receiving care. Minimal identity (05 §4): name, sex, DOB, number, 1 phone.
model Patient {
  id            String    @id @default(cuid())
  hospitalId    String
  patientNumber String
  familyName    String
  givenName     String
  sex           Sex
  dateOfBirth   DateTime  @db.Date
  phone         String?
  residence     String?
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Phase 2B — patient identity enhancements (additive). When the DOB is unknown, an
  // estimated age derives an approximate birth year stored in `dateOfBirth` (Jan 1) with
  // `isEstimatedAge = true`. Temporary/unidentified patients carry an immutable original
  // `temporaryIdentifier` (`Inconnu_YYMMDD_NN`) that is also retained in the audit log.
  guardianPhone       String?
  estimatedAge        Int?
  isEstimatedAge      Boolean @default(false)
  isTemporaryIdentity Boolean @default(false)
  temporaryIdentifier String?

  hospital         Hospital          @relation(fields: [hospitalId], references: [id])
  encounters       Encounter[]
  prescriptions    Prescription[]
  queueTickets     QueueTicket[]
  emergencyDebts   EmergencyDebt[]
  admissions       Admission[]
  diagnosticOrders DiagnosticOrder[]

  // Phase 1 (Gate 2) additive relations.
  contacts            PatientContact[]
  identifiers         PatientIdentifier[]
  duplicateCandidates PatientDuplicateCandidate[] @relation("DuplicatePatient")
  duplicateMatches    PatientDuplicateCandidate[] @relation("DuplicateCandidatePatient")

  @@unique([hospitalId, patientNumber])
  @@index([hospitalId, familyName, givenName])
}

// ===================== Encounter / visit =====================

/// A visit bringing a patient into the hospital.
model Encounter {
  id                   String          @id @default(cuid())
  hospitalId           String
  patientId            String
  encounterNumber      String
  serviceLabel         String
  // Phase 2B — optional link to the configured service catalogue (ServiceUnit). `serviceLabel`
  // (free text) is kept for back-compat; new visits also record the picked service id.
  serviceUnitId        String?
  reason               String
  status               EncounterStatus @default(open)
  assignedToId         String?
  openedAt             DateTime        @default(now())
  closedAt             DateTime?
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?
  // Phase 2H — emergency ("treat first, pay later") exception. A triage nurse/doctor flags the
  // encounter as emergency, which lets dispensing bypass the cashier paid-check and lets charges
  // accrue as auditable Emergency Debt to be settled or waived (by the Director) before discharge.
  isEmergency          Boolean         @default(false)
  emergencyFlaggedById String?
  emergencyFlaggedAt   DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  hospital         Hospital          @relation(fields: [hospitalId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  serviceUnit      ServiceUnit?      @relation(fields: [serviceUnitId], references: [id])
  assignedTo       User?             @relation("EncounterAssignedTo", fields: [assignedToId], references: [id])
  consultations    Consultation[]
  invoices         Invoice[]
  prescriptions    Prescription[]
  emergencyDebts   EmergencyDebt[]
  admissions       Admission[]
  diagnosticOrders DiagnosticOrder[]

  @@unique([hospitalId, encounterNumber])
  @@index([hospitalId, patientId])
}

// ===================== Clinical =====================

/// A clinical contact during an encounter. Minimal: reason + free-text fields (05 §4).
model Consultation {
  id                   String             @id @default(cuid())
  hospitalId           String
  encounterId          String
  status               ConsultationStatus @default(draft)
  reason               String
  clinicalNote         String?
  vitals               String?
  provisionalDiagnosis String?
  recommendation       String?
  performedById        String?
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  hospital    Hospital  @relation(fields: [hospitalId], references: [id])
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  performedBy User?     @relation("ConsultationPerformedBy", fields: [performedById], references: [id])

  // Phase 1 (Gate 2) additive relations (free-text fields above are kept).
  observations Observation[]
  diagnoses    Diagnosis[]

  @@index([hospitalId, encounterId])
}

// ===================== Billing (integer FCFA) =====================

/// A bill for an encounter. Total = sum of line totals (05 §9).
model Invoice {
  id            String        @id @default(cuid())
  hospitalId    String
  encounterId   String
  invoiceNumber String
  status        InvoiceStatus @default(draft)
  totalAmount   Int           @default(0)
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  hospital  Hospital      @relation(fields: [hospitalId], references: [id])
  encounter Encounter     @relation(fields: [encounterId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  // Phase 2C additive relations.
  cancellationRequests InvoiceCancellationRequest[]
  refundVouchers       RefundVoucher[]

  // Phase 2G additive relation — a hospitalization invoice belongs to at most one admission.
  admission Admission?

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId, encounterId])
}

/// One billed line. label/quantity/unitAmount/lineTotal are a HISTORICAL SNAPSHOT
/// (integer FCFA) — never rewritten by later Tariff changes. `tariffId` is an OPTIONAL
/// source reference only (Phase 1, Gate 2); the snapshot remains the source of truth.
model InvoiceItem {
  id         String   @id @default(cuid())
  hospitalId String
  invoiceId  String
  tariffId   String?
  label      String
  quantity   Int      @default(1)
  unitAmount Int
  lineTotal  Int
  createdAt  DateTime @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tariff   Tariff?  @relation(fields: [tariffId], references: [id])

  @@index([invoiceId])
  @@index([tariffId])
}

/// Money received against an invoice. amount is integer FCFA. Partial payments allowed.
model Payment {
  id            String        @id @default(cuid())
  hospitalId    String
  invoiceId     String
  receiptNumber String
  amount        Int
  method        PaymentMethod @default(cash)
  status        PaymentStatus @default(recorded)
  paidAt        DateTime      @default(now())
  cashierId     String?
  printedAt     DateTime?
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  cashier  User?    @relation("PaymentCashier", fields: [cashierId], references: [id])

  @@unique([hospitalId, receiptNumber])
  @@index([hospitalId, invoiceId])
}

// ===================== System =====================

/// Immutable record of significant actions (append-only, 05 §8). hospitalId is
/// nullable so pre-selection events (e.g. auth.login) can still be logged.
model AuditLog {
  id         String   @id @default(cuid())
  hospitalId String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  actor    User?     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([hospitalId, createdAt])
}

/// Per-hospital, per-type, per-year counter for human-readable numbers (05 §6).
model Sequence {
  id         String       @id @default(cuid())
  hospitalId String
  type       SequenceType
  year       Int
  current    Int          @default(0)
  updatedAt  DateTime     @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, type, year])
}

// ============ Phase 1 (Gate 2) — Configuration / master data (additive) ============
// Hospital-scoped config; soft-delete; configuration-before-customization (19/20 §A).

/// Organizational unit within a hospital. Hospital-scoped config.
model Department {
  id         String    @id @default(cuid())
  hospitalId String
  code       String
  name       String
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  serviceUnits ServiceUnit[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

/// A configurable service/department in the hospital catalogue (Phase 2A) — the foundation
/// every later module routes through. Existing Phase 1 fields (name, kind, departmentId)
/// are KEPT; Phase 2A adds bilingual labels, a typed classification, ordering, and
/// eligibility flags additively (no removals/renames; Phase 1A flows untouched).
model ServiceUnit {
  id           String    @id @default(cuid())
  hospitalId   String
  departmentId String?
  code         String
  name         String
  kind         String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Phase 2A — service-catalogue foundation (additive). nameFr/nameEn backfilled from `name`.
  nameFr              String?
  nameEn              String?
  type                ServiceType @default(SUPPORT)
  displayOrder        Int         @default(0)
  acceptsQueue        Boolean     @default(false)
  acceptsConsultation Boolean     @default(false)
  supportsBilling     Boolean     @default(false)
  supportsPharmacy    Boolean     @default(false)
  supportsLab         Boolean     @default(false)
  supportsImaging     Boolean     @default(false)
  isInpatientWard     Boolean     @default(false)
  isEmergency         Boolean     @default(false)

  hospital       Hospital      @relation(fields: [hospitalId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  encounters     Encounter[]
  queueTickets   QueueTicket[]
  wardAdmissions Admission[]

  @@unique([hospitalId, code])
  @@index([hospitalId, departmentId])
  @@index([hospitalId, type])
}

/// Configurable key/value setting; per-hospital (hospitalId set) or global (null). Config.
model Setting {
  id         String    @id @default(cuid())
  hospitalId String?
  key        String
  value      String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital Hospital? @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, key])
  @@index([hospitalId])
}

/// Printed-document wording/header (e.g. receipt header); per-hospital or global. Config.
model DocumentTemplate {
  id         String    @id @default(cuid())
  hospitalId String?
  type       String
  name       String
  header     String?
  body       String?
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital Hospital? @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, type, name])
  @@index([hospitalId])
}

// ============ Phase 3A — Multi-hospital configuration foundation (additive) ============
// Templates separate REUSABLE, hospital-agnostic configuration (a blueprint) from a
// hospital INSTANCE's own config rows (Department/ServiceUnit/Setting/DocumentTemplate,
// already hospital-scoped). A template is a shared artifact — NOT hospital-scoped, and
// NEVER a hard-coded global default (Bertoua is snapshotted into one, like any other).
// Templates carry NO patient/transaction data and NO hospital identity (name/city stays
// per-instance, so two hospitals built from the same template still differ by data alone).

/// A reusable, hospital-agnostic configuration blueprint. `content` is a structured JSON
/// payload (departments, services + eligibility flags, settings, document templates).
/// `sourceHospitalId` is provenance only (e.g. Bertoua) — NOT a scoping key.
model ConfigurationTemplate {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  version          Int      @default(1)
  sourceHospitalId String?
  content          Json
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications ConfigurationTemplateApplication[]

  @@index([sourceHospitalId])
}

/// Audit-grade record of a guarded, hospital-scoped template apply. Records which template
/// (+version) was applied to which hospital instance, by whom, and how many config rows were
/// created / updated / skipped. Hospital-scoped; carries no patient data.
model ConfigurationTemplateApplication {
  id              String   @id @default(cuid())
  hospitalId      String
  templateId      String
  templateCode    String
  templateVersion Int
  appliedById     String
  createdCount    Int      @default(0)
  updatedCount    Int      @default(0)
  skippedCount    Int      @default(0)
  summary         String
  createdAt       DateTime @default(now())

  hospital Hospital              @relation(fields: [hospitalId], references: [id])
  template ConfigurationTemplate @relation(fields: [templateId], references: [id])

  @@index([hospitalId])
  @@index([templateId])
}

// ============ Phase 3C — Site readiness & deployment checklist (additive) ============
// App-level STATUS TRACKING only — the software team performs no hardware/LAN/cyber work.
// Supplier-dependent items (hardware/LAN/UPS/cybersecurity) cannot be self-claimed READY.

enum SiteReadinessStatus {
  not_started
  in_progress
  ready
  blocked
  not_applicable
  needs_validation
}

/// One readiness checklist item for a hospital (per category). Status-tracking only — never
/// performs infrastructure work. Hospital-scoped; one row per (hospital, category).
model SiteReadinessItem {
  id           String              @id @default(cuid())
  hospitalId   String
  category     String
  status       SiteReadinessStatus @default(not_started)
  owner        String?
  evidenceNote String?
  verifier     String?
  statusDate   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, category])
  @@index([hospitalId])
}

// ============ Phase 1 (Gate 2) — Patient identity / contact (additive) ============
// Phase 0 Patient fields (phone/residence) KEPT. No MPI, no merge, no survivorship,
// no global de-duplication (19/20 §B).

/// Optional contact datum for a patient (phone/address/next-of-kin). Hospital-scoped.
model PatientContact {
  id          String    @id @default(cuid())
  hospitalId  String
  patientId   String
  contactType String
  value       String
  label       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@index([hospitalId, patientId])
}

/// Optional administrative identifier. Uniqueness is HOSPITAL-LOCAL (not national; no
/// MPI / no global de-duplication). Hospital-scoped.
model PatientIdentifier {
  id               String    @id @default(cuid())
  hospitalId       String
  patientId        String
  identifierType   String
  value            String
  issuingAuthority String?
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@unique([hospitalId, identifierType, value])
  @@index([hospitalId, patientId])
}

/// Possible-duplicate hint between two patients in one hospital. WARNING/REVIEW ONLY —
/// no merge, no survivorship, no MPI. Hospital-scoped.
model PatientDuplicateCandidate {
  id                 String   @id @default(cuid())
  hospitalId         String
  patientId          String
  candidatePatientId String
  matchBasis         String
  status             String   @default("open")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hospital         Hospital @relation(fields: [hospitalId], references: [id])
  patient          Patient  @relation("DuplicatePatient", fields: [patientId], references: [id])
  candidatePatient Patient  @relation("DuplicateCandidatePatient", fields: [candidatePatientId], references: [id])

  @@unique([hospitalId, patientId, candidatePatientId])
  @@index([hospitalId, status])
}

// ============ Phase 1 (Gate 2) — Clinical structure (additive) ============
// Consultation free-text `vitals` / `provisionalDiagnosis` are KEPT (transition).
// Clinical actions still reference User; no Practitioner; no legal-EMR finalization
// beyond current scope (19/20 §C).

/// Structured measured value within a consultation (over the free-text `vitals`).
model Observation {
  id             String    @id @default(cuid())
  hospitalId     String
  consultationId String
  type           String
  value          String
  unit           String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  hospital     Hospital     @relation(fields: [hospitalId], references: [id])
  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@index([hospitalId, consultationId])
}

/// Structured/coded diagnosis within a consultation (over `provisionalDiagnosis`).
model Diagnosis {
  id             String    @id @default(cuid())
  hospitalId     String
  consultationId String
  code           String?
  label          String
  isPrimary      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  hospital     Hospital     @relation(fields: [hospitalId], references: [id])
  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@index([hospitalId, consultationId])
}

// ============ Phase 1 (Gate 2) — Tariff / price list (additive, integer FCFA) ============
// InvoiceItem keeps its snapshot; later Tariff changes never alter past invoices/
// receipts. Integer FCFA only — no floats (19/20 §D).

/// A set of tariffs effective for a hospital/period. Hospital-scoped config.
model PriceList {
  id            String    @id @default(cuid())
  hospitalId    String
  code          String
  name          String
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  tariffs  Tariff[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

/// A priced billable item (integer FCFA). An OPTIONAL source for InvoiceItem; the
/// InvoiceItem keeps its own snapshot so billing history is never rewritten.
model Tariff {
  id            String    @id @default(cuid())
  hospitalId    String
  priceListId   String?
  code          String
  label         String
  amount        Int
  isActive      Boolean   @default(true)
  // Phase 2C — OPTIONAL effective dates (additive). Purely informational for pricing validity;
  // they never alter existing InvoiceItem snapshots (billing history is immutable).
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  priceList    PriceList?    @relation(fields: [priceListId], references: [id])
  invoiceItems InvoiceItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, priceListId])
}

// ============ Phase 2B — Diagnosis code reference (ICD-10 subset, GLOBAL) ============

/// Configurable ICD-10 diagnosis-code reference subset (GLOBAL standard data, not
/// hospital-scoped). Seeded with a small subset for UAT; importing the full ICD-10
/// catalogue is a documented extension path, NOT done here. The per-consultation
/// `Diagnosis` rows record a `code` + `label` chosen from this reference.
model DiagnosisCode {
  id           String   @id @default(cuid())
  code         String   @unique
  labelFr      String
  labelEn      String
  category     String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// ============ Phase 2C — cancellation, refund voucher, Brouillard de Caisse ============

/// A cashier's request to cancel an invoice, decided by a Hospital Administrator. The cashier may
/// NOT approve their own request (requester ≠ approver, enforced at the service layer). Two distinct
/// events: the request, then the decision. On approval the invoice (and its recorded payments) are
/// cancelled and — when the invoice had recorded payments — a linked RefundVoucher is generated.
model InvoiceCancellationRequest {
  id             String                    @id @default(cuid())
  hospitalId     String
  invoiceId      String
  status         CancellationRequestStatus @default(requested)
  reason         String
  requestedById  String
  decidedById    String?
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  hospital      Hospital       @relation(fields: [hospitalId], references: [id])
  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  requestedBy   User           @relation("CancellationRequestedBy", fields: [requestedById], references: [id])
  decidedBy     User?          @relation("CancellationDecidedBy", fields: [decidedById], references: [id])
  refundVoucher RefundVoucher?

  @@index([hospitalId, status])
  @@index([invoiceId])
}

/// Refund voucher ("bon d'avoir") for a cancelled PAID invoice, linked to the originating invoice
/// and cancellation request. Lifecycle: requested → approved → paid (the physical cash-out is
/// recorded at "paid"/executed) — or cancelled. Amounts are integer FCFA.
model RefundVoucher {
  id                    String              @id @default(cuid())
  hospitalId            String
  voucherNumber         String
  invoiceId             String
  cancellationRequestId String              @unique
  amount                Int
  status                RefundVoucherStatus @default(requested)
  reason                String
  requestedById         String
  approvedById          String?
  executedById          String?
  cancelledById         String?
  approvedAt            DateTime?
  executedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  hospital            Hospital                   @relation(fields: [hospitalId], references: [id])
  invoice             Invoice                    @relation(fields: [invoiceId], references: [id])
  cancellationRequest InvoiceCancellationRequest @relation(fields: [cancellationRequestId], references: [id])
  requestedBy         User                       @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  approvedBy          User?                      @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  executedBy          User?                      @relation("RefundExecutedBy", fields: [executedById], references: [id])
  cancelledBy         User?                      @relation("RefundCancelledBy", fields: [cancelledById], references: [id])

  @@unique([hospitalId, voucherNumber])
  @@index([hospitalId, status])
  @@index([invoiceId])
}

/// Cashier shift + Brouillard de Caisse. Opened with an opening balance; on close the five
/// mandatory totals are FROZEN (integer FCFA) and the record becomes immutable. Corrections never
/// mutate the frozen figures — they are appended as CashierShiftCorrection rows and flip the status
/// to `corrected`. Shift totals are attributed by the cashier's recorded payments within the shift
/// window [openedAt, closedAt) (deterministic; no Payment FK to keep the change additive).
model CashierShift {
  id                        String             @id @default(cuid())
  hospitalId                String
  shiftNumber               String
  cashierId                 String
  status                    CashierShiftStatus @default(open)
  openingBalance            Int                @default(0)
  totalCashReceived         Int                @default(0)
  totalMobileCardReceived   Int                @default(0)
  totalCancellationsRefunds Int                @default(0)
  expectedClosingBalance    Int                @default(0)
  receiptCount              Int                @default(0)
  openedAt                  DateTime           @default(now())
  closedAt                  DateTime?
  closedById                String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  hospital    Hospital                 @relation(fields: [hospitalId], references: [id])
  cashier     User                     @relation("ShiftCashier", fields: [cashierId], references: [id])
  closedBy    User?                    @relation("ShiftClosedBy", fields: [closedById], references: [id])
  corrections CashierShiftCorrection[]

  @@unique([hospitalId, shiftNumber])
  @@index([hospitalId, cashierId, status])
}

/// An append-only correction note against a CLOSED Brouillard. The original frozen totals are never
/// modified; this records a controlled, audited adjustment (reason + note + who + when).
model CashierShiftCorrection {
  id             String   @id @default(cuid())
  hospitalId     String
  cashierShiftId String
  reason         String
  note           String
  correctedById  String
  createdAt      DateTime @default(now())

  hospital     Hospital     @relation(fields: [hospitalId], references: [id])
  cashierShift CashierShift @relation(fields: [cashierShiftId], references: [id])
  correctedBy  User         @relation("ShiftCorrectedBy", fields: [correctedById], references: [id])

  @@index([cashierShiftId])
}

// ===================== Phase 2D — pharmacy / medication =====================

/// Hospital-scoped medication catalogue (Phase 2D-1). Fr/En names, galenic form, dispensing unit,
/// optional strength, active flag, display order. Integer quantities live on the stock ledger
/// (2D-3) and prescriptions (2D-2) — the catalogue itself carries no quantities or prices.
model Medication {
  id           String    @id @default(cuid())
  hospitalId   String
  code         String
  nameFr       String
  nameEn       String
  form         String
  unit         String
  strength     String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  createdById  String?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hospital          Hospital               @relation(fields: [hospitalId], references: [id])
  prescriptionItems PrescriptionItem[]
  stockBatches      MedicationStockBatch[]
  stockAdjustments  StockAdjustment[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive, displayOrder])
}

/// Phase 2D-3 — a received batch/lot of a medication, with mandatory batch number + expiry date and
/// integer quantities. `quantityOnHand` is the physical available stock; `quantityReserved` (Phase
/// 2D-4) is held by finalized prescriptions; available-to-reserve = onHand − reserved. Dispensing
/// (2D-5) deducts from `quantityOnHand`. FEFO (2D-6) selects the earliest `expiryDate` first.
model MedicationStockBatch {
  id               String   @id @default(cuid())
  hospitalId       String
  medicationId     String
  batchNumber      String
  expiryDate       DateTime @db.Date
  quantityReceived Int
  quantityOnHand   Int
  quantityReserved Int      @default(0)
  receivedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hospital            Hospital             @relation(fields: [hospitalId], references: [id])
  medication          Medication           @relation(fields: [medicationId], references: [id])
  reservations        StockReservation[]
  dispenseRecordItems DispenseRecordItem[]
  adjustments         StockAdjustment[]

  @@index([hospitalId, medicationId, expiryDate])
}

/// Phase 2D-4 — a FEFO reservation of stock held by a finalized/sent prescription line against a
/// specific batch. While `active` it adds to the batch's `quantityReserved` (no on-hand deduction).
/// Releasing (48h non-collection / cancellation) returns the reserved units; dispensing (2D-5)
/// consumes the reservation and deducts on-hand.
model StockReservation {
  id                 String            @id @default(cuid())
  hospitalId         String
  prescriptionId     String
  prescriptionItemId String
  medicationId       String
  batchId            String
  quantity           Int
  status             ReservationStatus @default(active)
  releasedAt         DateTime?
  consumedAt         DateTime?
  createdById        String?
  // Phase 2D-6 — FEFO override: set when the Pharmacist-in-Charge re-points this reservation off its
  // earliest-expiry (FEFO) batch onto a deliberately chosen batch, with a mandatory reason. Audited as
  // `fefo.override`. Default (FEFO) reservations leave these false/null.
  isFefoOverride     Boolean           @default(false)
  overrideReason     String?
  overrideById       String?
  overrideAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  hospital         Hospital             @relation(fields: [hospitalId], references: [id])
  prescription     Prescription         @relation(fields: [prescriptionId], references: [id])
  prescriptionItem PrescriptionItem     @relation(fields: [prescriptionItemId], references: [id])
  batch            MedicationStockBatch @relation(fields: [batchId], references: [id])

  @@index([hospitalId, status, createdAt])
  @@index([prescriptionId])
  @@index([batchId])
}

/// Phase 2D-7 — a dual-validated stock adjustment against a batch. A `pharmacien` REQUESTS (kind +
/// positive magnitude + mandatory reason); the `pharmacien_chef` APPROVES (on-hand is changed) or
/// REJECTS (mandatory decision reason). Requester ≠ approver. The on-hand mutation happens ONLY on
/// approval; the InvoiceItem-style history is preserved (the request row is never rewritten).
model StockAdjustment {
  id             String                @id @default(cuid())
  hospitalId     String
  batchId        String
  medicationId   String
  type           StockAdjustmentType
  quantity       Int // positive magnitude; the on-hand delta is signed by `type`
  reason         String
  status         StockAdjustmentStatus @default(requested)
  requestedById  String
  decidedById    String?
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  hospital    Hospital             @relation(fields: [hospitalId], references: [id])
  batch       MedicationStockBatch @relation(fields: [batchId], references: [id])
  medication  Medication           @relation(fields: [medicationId], references: [id])
  requestedBy User                 @relation("StockAdjustmentRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?                @relation("StockAdjustmentDecidedBy", fields: [decidedById], references: [id])

  @@index([hospitalId, status, createdAt])
  @@index([batchId])
}

/// Phase 2E — an audited record of a manual aggregate export (e.g. the DHIS2-aligned monthly CSV).
/// History only — it stores WHAT aggregate export was run (kind, period, row count) and BY WHOM, never
/// any exported patient data (the exports themselves are aggregate-only, no nominative fields).
model ReportExport {
  id           String   @id @default(cuid())
  hospitalId   String
  kind         String // e.g. "dhis2_monthly"
  periodLabel  String // e.g. "2026-06"
  periodStart  DateTime
  periodEnd    DateTime
  rowCount     Int
  exportedById String
  createdAt    DateTime @default(now())

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  exportedBy User     @relation("ReportExportedBy", fields: [exportedById], references: [id])

  @@index([hospitalId, createdAt])
}

/// Phase 2F — a simple per-service digital queue ticket (replaces the physical arrival register). A
/// registered patient is queued for a service on a given day; `ticketNumber` is sequential per
/// hospital + service + day (resets daily). `isUrgent` lets a triage override jump the line (audited).
model QueueTicket {
  id            String      @id @default(cuid())
  hospitalId    String
  serviceUnitId String
  patientId     String
  queueDate     DateTime    @db.Date
  ticketNumber  Int
  status        QueueStatus @default(waiting)
  isUrgent      Boolean     @default(false)
  calledAt      DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  hospital    Hospital    @relation(fields: [hospitalId], references: [id])
  serviceUnit ServiceUnit @relation(fields: [serviceUnitId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@unique([hospitalId, serviceUnitId, queueDate, ticketNumber])
  @@index([hospitalId, serviceUnitId, queueDate, status])
}

/// Phase 2H — an auditable Emergency Debt ledger entry. Each entry is an amount the patient owes for
/// emergency ("treat first, pay later") care on an encounter; it can only move from `outstanding` to
/// `settled` (paid later) or `waived` (Hospital Director). Entries are never deleted — the ledger is
/// append-and-transition only, so emergency debt can never silently disappear.
model EmergencyDebt {
  id             String              @id @default(cuid())
  hospitalId     String
  encounterId    String
  patientId      String
  amount         Int // integer FCFA
  source         String // what the debt is for, e.g. "Consultation", "Soins d'urgence"
  status         EmergencyDebtStatus @default(outstanding)
  createdById    String?
  decidedById    String?
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  hospital  Hospital  @relation(fields: [hospitalId], references: [id])
  encounter Encounter @relation(fields: [encounterId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])

  @@index([hospitalId, encounterId, status])
}

/// Phase 2G — simple ward-level hospitalization lifecycle. A doctor REQUESTS admission; the admission
/// desk / head nurse ASSIGNS a ward (an INPATIENT_WARD service) which starts the daily ward fee; the
/// doctor REQUESTS then AUTHORISES discharge (the latter is blocked while invoices are unpaid or
/// emergency debt is outstanding). `requested → admitted → discharge_requested → discharged`, plus
/// `requested → cancelled` (before a ward is assigned). No bed/room-level tracking.
enum AdmissionStatus {
  requested
  admitted
  discharge_requested
  discharged
  cancelled
}

/// Phase 2I — diagnostic modality (manual workflows only; radiology is text-only, no PACS/DICOM).
enum DiagnosticModality {
  lab
  radiology
}

/// Phase 2I — manual lab/radiology order lifecycle. `requested → payment_confirmed → in_progress →
/// result_entered → validated` (+ `cancelled` before validation). The doctor cannot see the result
/// until `validated`. Payment is bypassed for emergency (2H) encounters.
enum DiagnosticOrderStatus {
  requested
  payment_confirmed
  in_progress
  result_entered
  validated
  cancelled
}

/// Phase 2G — a ward-level hospitalization tied to an encounter. Bed/room-level tracking is out of
/// scope. The daily ward fee is resolved from the ward's active Tariff and SNAPSHOT here at assignment
/// (deterministic + auditable); daily charges accrue onto a single hospitalization Invoice.
model Admission {
  id                   String          @id @default(cuid())
  hospitalId           String
  encounterId          String
  patientId            String
  admissionNumber      String
  status               AdmissionStatus @default(requested)
  reason               String
  // Ward assignment (set when status → admitted). The daily ward fee is snapshot from the ward tariff.
  wardServiceUnitId    String?
  dailyWardFee         Int             @default(0) // integer FCFA, snapshot at assignment
  dailyFeeTariffId     String?
  // The single hospitalization invoice the daily ward fees accrue onto (created lazily on first charge).
  invoiceId            String?         @unique
  cancelReason         String?
  requestedById        String?
  admittedById         String?
  dischargedById       String?
  cancelledById        String?
  requestedAt          DateTime        @default(now())
  admittedAt           DateTime?
  dischargeRequestedAt DateTime?
  dischargedAt         DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  hospital     Hospital               @relation(fields: [hospitalId], references: [id])
  encounter    Encounter              @relation(fields: [encounterId], references: [id])
  patient      Patient                @relation(fields: [patientId], references: [id])
  wardService  ServiceUnit?           @relation(fields: [wardServiceUnitId], references: [id])
  invoice      Invoice?               @relation(fields: [invoiceId], references: [id])
  dailyCharges AdmissionDailyCharge[]

  @@unique([hospitalId, admissionNumber])
  @@index([hospitalId, status])
  @@index([hospitalId, encounterId])
}

/// Phase 2G — one auditable daily ward-fee charge for an admission. The `@@unique` on (admission, day)
/// makes fee generation idempotent: charging the same day twice never double-bills. Each charge maps to
/// one InvoiceItem (`invoiceItemId`) appended to the admission's hospitalization invoice.
model AdmissionDailyCharge {
  id            String   @id @default(cuid())
  hospitalId    String
  admissionId   String
  chargeDate    DateTime @db.Date
  amount        Int // integer FCFA — the snapshot daily ward fee
  invoiceItemId String?
  createdById   String?
  createdAt     DateTime @default(now())

  hospital  Hospital  @relation(fields: [hospitalId], references: [id])
  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, admissionId, chargeDate])
  @@index([hospitalId, admissionId])
}

/// Phase 2I — the orderable lab/radiology catalogue, maintained at hospital level by the Admin (or
/// Lead Tech). `price` is integer FCFA (snapshot onto the order at request time). No analyzer/PACS.
model DiagnosticCatalogueItem {
  id           String             @id @default(cuid())
  hospitalId   String
  code         String
  nameFr       String
  nameEn       String?
  modality     DiagnosticModality
  price        Int                @default(0) // integer FCFA
  isActive     Boolean            @default(true)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  hospital Hospital          @relation(fields: [hospitalId], references: [id])
  orders   DiagnosticOrder[]

  @@unique([hospitalId, code])
  @@index([hospitalId, modality])
}

/// Phase 2I — a manual lab/radiology order. Doctor requests → cashier confirms payment (or emergency
/// bypass, 2H) → technician enters a TEXT result → validator validates → PDF. The `resultText` is
/// hidden from the requesting doctor (service-enforced) until `status = validated`. Modality/label/
/// price are SNAPSHOT from the catalogue item at request time. Append-and-transition; never deleted.
model DiagnosticOrder {
  id                String                @id @default(cuid())
  hospitalId        String
  encounterId       String
  patientId         String
  catalogueItemId   String?
  orderNumber       String
  modality          DiagnosticModality
  itemLabel         String // snapshot of the catalogue item name
  price             Int                   @default(0) // integer FCFA, snapshot
  status            DiagnosticOrderStatus @default(requested)
  isPaid            Boolean               @default(false)
  paidAt            DateTime?
  paidById          String?
  resultText        String?
  resultEnteredById String?
  resultEnteredAt   DateTime?
  validatedById     String?
  validatedAt       DateTime?
  cancelReason      String?
  requestedById     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  hospital      Hospital                 @relation(fields: [hospitalId], references: [id])
  encounter     Encounter                @relation(fields: [encounterId], references: [id])
  patient       Patient                  @relation(fields: [patientId], references: [id])
  catalogueItem DiagnosticCatalogueItem? @relation(fields: [catalogueItemId], references: [id])

  @@unique([hospitalId, orderNumber])
  @@index([hospitalId, status])
  @@index([hospitalId, encounterId])
  @@index([hospitalId, modality, status])
}

/// Phase 2D-2 — a structured prescription ("ordonnance") raised by a doctor during an encounter.
/// Lifecycle draft → finalized → sent_to_pharmacy (dispensing transitions are added by 2D-5). A
/// prescription has NO stock effect — it may later create a reservation (2D-4); dispensing (2D-5)
/// deducts stock. The printable PDF carries the hospital header + tracking number + doctor name +
/// signature space (e-signature deferred) + synthetic-data marker.
model Prescription {
  id                 String             @id @default(cuid())
  hospitalId         String
  prescriptionNumber String
  patientId          String
  encounterId        String
  prescribedById     String
  status             PrescriptionStatus @default(draft)
  notes              String?
  finalizedAt        DateTime?
  sentAt             DateTime?
  cancelledAt        DateTime?
  // Phase 2D-5 — collection payment confirmation (the patient paid at the cashier). Dispensing
  // requires `isPaid` (the paid check; emergency exception is Phase 2H, not built).
  isPaid             Boolean            @default(false)
  paidAt             DateTime?
  paidById           String?
  createdById        String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  hospital        Hospital           @relation(fields: [hospitalId], references: [id])
  patient         Patient            @relation(fields: [patientId], references: [id])
  encounter       Encounter          @relation(fields: [encounterId], references: [id])
  prescribedBy    User               @relation("PrescriptionPrescribedBy", fields: [prescribedById], references: [id])
  paidBy          User?              @relation("PrescriptionPaidBy", fields: [paidById], references: [id])
  items           PrescriptionItem[]
  reservations    StockReservation[]
  dispenseRecords DispenseRecord[]

  @@unique([hospitalId, prescriptionNumber])
  @@index([hospitalId, status])
  @@index([encounterId])
}

/// One prescribed line. `medicationLabel`/`unit` are a SNAPSHOT at prescribe time (the printed
/// prescription is stable even if the catalogue later changes); `medicationId` is the source link.
/// `quantity` is an integer (dispensing unit). No price here.
model PrescriptionItem {
  id              String   @id @default(cuid())
  hospitalId      String
  prescriptionId  String
  medicationId    String
  medicationLabel String
  unit            String
  dosage          String
  frequency       String?
  duration        String
  quantity        Int
  instructions    String?
  createdAt       DateTime @default(now())

  hospital            Hospital             @relation(fields: [hospitalId], references: [id])
  prescription        Prescription         @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication          Medication           @relation(fields: [medicationId], references: [id])
  reservations        StockReservation[]
  dispenseRecordItems DispenseRecordItem[]

  @@index([prescriptionId])
  @@index([medicationId])
}

/// Phase 2D-5 — a dispense event for a prescription. Records WHO dispensed WHAT from WHICH batch
/// (snapshot label) and HOW MUCH. Dispensing deducts batch `quantityOnHand` and consumes the
/// matching reservations. Printable with a tracking number. Integer quantities.
model DispenseRecord {
  id             String   @id @default(cuid())
  hospitalId     String
  dispenseNumber String
  prescriptionId String
  dispensedById  String
  createdAt      DateTime @default(now())

  hospital     Hospital             @relation(fields: [hospitalId], references: [id])
  prescription Prescription         @relation(fields: [prescriptionId], references: [id])
  dispensedBy  User                 @relation("DispensePerformedBy", fields: [dispensedById], references: [id])
  items        DispenseRecordItem[]

  @@unique([hospitalId, dispenseNumber])
  @@index([prescriptionId])
}

/// One dispensed line: which prescription line, which batch, how much (integer). `medicationLabel`
/// is a snapshot. FEFO-override (2D-6) records the override on this batch choice.
model DispenseRecordItem {
  id                 String   @id @default(cuid())
  hospitalId         String
  dispenseRecordId   String
  prescriptionItemId String
  batchId            String
  medicationLabel    String
  unit               String
  quantity           Int
  createdAt          DateTime @default(now())

  hospital         Hospital             @relation(fields: [hospitalId], references: [id])
  dispenseRecord   DispenseRecord       @relation(fields: [dispenseRecordId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem     @relation(fields: [prescriptionItemId], references: [id])
  batch            MedicationStockBatch @relation(fields: [batchId], references: [id])

  @@index([dispenseRecordId])
  @@index([batchId])
}
