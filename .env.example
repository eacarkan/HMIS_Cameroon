# Copy to `.env` and adjust for your machine. Local/fake values only — never real secrets.
# A local PostgreSQL (local install or Docker) is a prerequisite (see README).

# PostgreSQL connection string consumed by Prisma (D-003).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://hmis:hmis_dev_password@localhost:5432/hmis_cameroon?schema=public"

# Auth.js (D-005) session secret. Generate one with: npx auth secret  (or openssl rand -base64 33)
AUTH_SECRET="replace-with-a-local-dev-secret"
AUTH_TRUST_HOST="true"

# Show the demo-accounts + shared-password hint on the login screen. Default OFF so it
# never appears on stakeholder-facing screens. Set to "true" only for internal/dev use.
# (Inlined at build time — rebuild after changing.)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# Dedicated TEST database for integration + e2e tests (name MUST contain "test").
# It is reset/seeded with fake demo data on each run — never point it at dev/prod.
# Create it once: createdb hmis_cameroon_test && DATABASE_URL=<this> npx prisma db push
TEST_DATABASE_URL="postgresql://hmis:hmis_dev_password@localhost:5432/hmis_cameroon_test?schema=public"
