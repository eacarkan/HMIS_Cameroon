# Copy to `.env` and adjust for your machine. Local/fake values only — never real secrets.
# A local PostgreSQL (local install or Docker) is a prerequisite (see README).

# PostgreSQL connection string consumed by Prisma (D-003).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://hmis:hmis_dev_password@localhost:5432/hmis_cameroon?schema=public"

# Auth.js (D-005) session secret. Generate one with: npx auth secret  (or openssl rand -base64 33)
AUTH_SECRET="replace-with-a-local-dev-secret"
AUTH_TRUST_HOST="true"

# Show the demo-accounts + shared-password hint on the login screen. Default OFF so it
# never appears on stakeholder-facing screens. Set to "true" only for internal/dev use.
# (Inlined at build time — rebuild after changing.)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# Dedicated TEST database for integration + e2e tests (name MUST contain "test").
# It is reset/seeded with fake demo data on each run — never point it at dev/prod.
# Create it once: createdb hmis_cameroon_test && DATABASE_URL=<this> npx prisma db push
TEST_DATABASE_URL="postgresql://hmis:hmis_dev_password@localhost:5432/hmis_cameroon_test?schema=public"

# ---------------------------------------------------------------------------
# Phase 6 — SantéGrid stakeholder-demo web deployment (Vercel Pro + Neon).
# Placeholders only — NO real secrets in the repo. Real values are set ONLY in the
# Vercel/Neon environment settings for the controlled stakeholder-demo deployment.
# Synthetic data only · not production · not Gate 7 · no live integrations.
# ---------------------------------------------------------------------------

# Deployment environment marker. Only "stakeholder-demo" unlocks the demo surface;
# any other value (incl. unset) is treated as "local". Fails closed.
HMIS_ENVIRONMENT="stakeholder-demo"

# Enable the public (unauthenticated) SantéGrid marketing/showcase site + the front door
# (an unauthenticated visitor to a protected route lands on /accueil). Fails closed.
HMIS_PUBLIC_SITE_ENABLED="true"

# Flag-gated one-click demo login. KEPT false here. The deployment runbook may instruct the
# operator to set "true" ONLY for the controlled stakeholder-demo deployment. One-click also
# requires HMIS_ENVIRONMENT=stakeholder-demo (both must hold). Fails closed.
HMIS_PUBLIC_DEMO_LOGIN_ENABLED="false"

# Synthetic-data markers (declarative). The app is synthetic-only regardless (real-data path
# is compiled off); these surface the posture on the health route / status page.
HMIS_SYNTHETIC_DATA_ONLY="true"
HMIS_SHOW_SYNTHETIC_BANNER="true"

# Live integrations stay OFF (mock/sandbox-first). Only the exact string "true" would enable
# them, and no production adapter ships — leave these unset/false for the stakeholder demo.
HMIS_INTEGRATION_LIVE_ENABLED="false"
HMIS_MPI_LIVE_ENABLED="false"

# The SYNTHETIC shared demo password — SERVER-SIDE ONLY (Phase 6.1). Used to seed the demo
# users and for server-side one-click demo login. It is NOT committed and NOT exposed to the
# client; set a synthetic value here (local) or in the Vercel env (stakeholder demo). Fails
# closed if unset where required. Placeholder only — never a real password.
HMIS_DEMO_SHARED_PASSWORD="<set-in-vercel-or-local-demo-env>"

# Optional PUBLIC hint/display of the demo password shown on the demo-access page (client-safe).
# Never a real password. If unset, the page shows a clearly-marked placeholder. (Inlined at build.)
NEXT_PUBLIC_DEMO_PASSWORD_HINT="<optional-public-demo-password-or-hint>"

# Optional: the published stakeholder-feedback email shown on the public /retours page
# (email-based feedback only; no in-app form). If unset, a placeholder is shown.
NEXT_PUBLIC_FEEDBACK_EMAIL=""
